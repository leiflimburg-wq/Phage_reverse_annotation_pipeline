
params
{
    // general configurations
        pubDirMode = "copy"

     // Pipeline modes
        //determines if proteins with function assigned by Phold are folded and checkted with foldseek and folddsico (has no effect if onlyMatch or external_aa_fasta are true)
        annotateAll = true

        //keep only 0-1 of following options true to avoid unexpected behavior:
        //determines if proteins are only anntotated and folded and NOT checked with foldseek and folddsico (mutualy exclusive with externall_aa_fasta and onlyMatch)
        dontMatch = false
        //determines if the annotation is skipped and the proteins are only folded and Matched (mutaly exclusive with dontMatch and onlyMatch)
        //only matches proteins from the protein folder (see Input and Output) against the curated DB (mutualy exclusive with externall_aa_fasta and DontMatch)
        onlyMatch = false
        //this settings removes the locus Tag from phold annotations for shorter proteinnames in the result files, only keep this setting "true" if the annoation is/ or was dne by phold. Due to parsing problems this has to be string.
        known_naming_structure = true



    //Result Cutoff //higher values increase the chance of false positives

        foldseek_evalue = 1
        //validation proteins scored between 0.03 and 0.04
        folddisco_rmsd = 3

    //ESMfold paramaters
        //if the pharokka and phold steps are not requiered set this to "True" (is passed to python script) and add an fasta in the format: header \n aa_sequnence \n header ...| it is important that aa sequnces are fully in one line
        external_aa_fasta = false
        maxfolding = 5000 

   
        
    // Conda environments
        //conda_path = "/absolute/path/to/conda/" // e.g. /home/user/miniconda3/envs --> important to direct down until envs directory
            conda_path = "/ceph/ibmi/it/dont-backup/limburg/miniforge3/envs"

    //Input and Output
        phageGenomeFolder = "/ceph/ibmi/ipb/students/limburg/BASEL_Annotations/BASEL_genomes"
        outputDir = "/ceph/ibmi/ipb/students/limburg/BASEL_Annotations/run3"
        protein_folder = "/ceph/ibmi/ipb/students/limburg/git_pipeline/Phage_reverse_annotation_pipeline/folded_proteins"
        external_aa_path = "path/to/folder"

    //Databases Format is : "absolute/path/to/DBFolder"
        //Pipeline tested on PharokkaDB Version 1.8.0
            pharokkaDB = "/ceph/ibmi/it/dont-backup/limburg/pharokka_DB_1.8.0"
        //Pipeline tested on PholdDB Version ?
            pholdDB= "/ceph/ibmi/it/dont-backup/limburg/pholdDB"
        // path for the curated DB and the Excelfile containing the important sites
            curatedDB = "/ceph/ibmi/ipb/students/limburg/curated_DB/Database_0.1"
            site_map = "/ceph/ibmi/ipb/students/limburg/curated_DB/Database_0.1/Curated_DB_Map.xlsx"
        //the model cache for ESM Fold requieres more than 30GB of storage
            esm_model_cache = "/ceph/ibmi/ipb/students/limburg/ESM_cache/" 
        
    //validation & test paths
        validationprotein_pipeline = "/ceph/ibmi/ipb/students/limburg/pipeline_test/validation_files/validation_test.cif"
        validationprotein_reference = "/ceph/ibmi/ipb/students/limburg/pipeline_test/validation_files/MGYP001770710382.pdb"
    
    //caching
    pharokkaCache = true
    pholdCache = true
    esmfoldCache = true
    foldseekCache = true
    folddiscoCache = true

    //parallelisation and ressource allocation
        executor.cpus = 32
        //Forks*CPUs in one process should not exceed the available Threads
            pharokkaCPUs = 8
            pharokkaForks = 4
            pholdCPUs = 8
            pholdForks = 4
            foldseekCPUs = 8
            foldseekForks = 4
            folddiscoCPUs = 8
            folddiscoForks = 4
        //determines the GPU ESMfold will run on // This is always an intiger e.g. 0 
            cuda_device = 1
        //determines the amount of proteins folded in parallel; can requiere up to ~40GB of VRAM per instance
            maxforks = 1
            esmForks = 1

    //note: folddisco requieres any proteins in the CuratedDB to be converted by gemmi via "gemmi convert X_old.cif X_new.cif" the gemmi yaml is in the env folder
    

}