
params
{
    // general configurations
        pubDirMode = "copy"

    //Result Cutoff //higher values increase the chance of false positives

        foldseek_evalue = 0.1
        //validation proteins scored between 0.03 and 0.04
        folddisco_rmsd = 3


    // determines if proteins with function assigned by Phold are folded and checkted with foldseek and folddsico// Can be true (4h 35m 38s) or false (02:54) // Note: setting this true will ~1,5x the runtime!
        annotateAll = true
        
    // Conda environments
        //conda_path = "/absolute/path/to/conda/" // e.g. /home/user/miniconda3/envs --> important to direct down until envs directory
            conda_path = "/ceph/ibmi/it/dont-backup/limburg/miniforge3/envs"

    //Input and Output
        phageGenomeFolder = "/ceph/ibmi/ipb/students/limburg/BASEL_Annotations/BASEL_genomes"
        outputDir = "/ceph/ibmi/ipb/students/limburg/BASEL_Annotations/run1"

    //Databases Format is : "absolute/path/to/DBFolder"
        //Pipeline tested on PharokkaDB Version 1.8.0
            pharokkaDB = "/ceph/ibmi/it/dont-backup/limburg/pharokka_DB_1.8.0"
        //Pipeline tested on PholdDB Version ?
            pholdDB= "/ceph/ibmi/it/dont-backup/limburg/pholdDB"
        // path for the curated DB and the Excelfile containing the important sites
            curatedDB = "/ceph/ibmi/ipb/students/limburg/curated_DB/Database_0.1"
            site_map = "/ceph/ibmi/ipb/students/limburg/curated_DB/Database_0.1/Curated_DB_Map.xlsx"
        //the model cache for ESM Fold requieres more than 30GB of storage
            esm_model_cache = "/ceph/ibmi/ipb/students/limburg/ESM_cache/" 
        
    //validation & test paths
        validationprotein_pipeline = "/ceph/ibmi/ipb/students/limburg/pipeline_test/validation_files/validation_test.cif"
        validationprotein_reference = "/ceph/ibmi/ipb/students/limburg/pipeline_test/validation_files/MGYP001770710382.pdb"
    
    //caching
    pharokkaCache = true
    pholdCache = true
    esmfoldCache = true
    foldseekCache = true
    folddiscoCache = true

    //parallelisation and ressource allocation
        executor.cpus = 32
        //Forks*CPUs in one process should not exceed the available Threads
            pharokkaCPUs = 8
            pharokkaForks = 4
            pholdCPUs = 8
            pholdForks = 4
            foldseekCPUs = 8
            foldseekForks = 4
            folddiscoCPUs = 8
            folddiscoForks = 4
        //determines the GPU ESMfold will run on // This is always an intiger e.g. 0 
            cuda_device = 0
        //determines the amount of proteins folded in parallel; can requiere up to ~40GB of VRAM per instance
            maxforks = 1
            esmForks = 1

    //note: folddisco requieres any proteins in the CuratedDB to be converted by gemmi via "gemmi convert X_old.cif X_new.cif" the gemmi yaml is in the env folder


}