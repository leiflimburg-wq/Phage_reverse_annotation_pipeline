    // ESM Fold cache
        esm_model_cache = "/ceph/ibmi/ipb/students/limburg/ESM_cache/" 

    // max Forks 
        maxforks = 1
    
    //validation & test paths
        validationprotein_pipeline = "/ceph/ibmi/ipb/students/limburg/pipeline_test/validation_files/validation_test.cif"
